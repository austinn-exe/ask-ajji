# Copy this file to .env and fill in real values. Never commit .env.

# Get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Any long random string — used to sign login tokens (JWTs).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-secret

# Optional — defaults to a local SQLite file if unset.
# DATABASE_URL=postgresql://user:password@localhost:5432/askajji
